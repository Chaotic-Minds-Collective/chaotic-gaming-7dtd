# 7 Days to Die adapter. Keep this in a local secret store; never commit real values.
CORE_API_BASE_URL=https://core.example.com
CORE_API_SERVICE_TOKEN=
CORE_SERVER_ID=
GAME_SERVER_VERSION=
ADAPTER_VERSION=0.1.0

# Built-in 7DTD Telnet interface. Set a strong password and restrict network access.
TELNET_HOST=127.0.0.1
TELNET_PORT=8081
TELNET_PASSWORD=

# Poll interval in milliseconds (minimum 30000).
HEARTBEAT_INTERVAL_MS=120000
