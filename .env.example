# 7 Days to Die adapter. Keep this in a local secret store; never commit real values.
CORE_API_BASE_URL=https://core.example.com
CORE_API_SERVICE_TOKEN=
CORE_SERVER_ID=
GAME_SERVER_VERSION=
ADAPTER_VERSION=0.1.0

# Optional local Telnet health-check helper; keep the interface private.
TELNET_HOST=127.0.0.1
TELNET_PORT=8081
TELNET_PASSWORD=
HEARTBEAT_INTERVAL_MS=120000

# Primary Web API/SSE bridge. Use paths from the OpenAPI/RapiDoc page on the exact server build.
SDTD_API_URL=https://127.0.0.1:8080/
SDTD_API_TOKEN_NAME=
SDTD_API_TOKEN_SECRET=
SDTD_SSE_ENDPOINT=
SDTD_ALLOW_INSECURE_HTTP=false

# Map exact source SSE event names to Core's normalized event types.
# Example only; confirm source event names from the running server before configuring.
SDTD_EVENT_MAP={}
CORE_EVENT_SPOOL_PATH=./data/core-events.jsonl
